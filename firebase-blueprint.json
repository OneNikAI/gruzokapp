{
  "entities": {
    "Chat": {
      "title": "Chat",
      "description": "Represents a chat session between a customer and a worker",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "customerId": { "type": "string" },
        "workerId": { "type": "string" },
        "dispatcherId": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "unreadCount": { "type": "object" }
      },
      "required": ["orderId", "customerId", "workerId"]
    },
    "Message": {
      "title": "Message",
      "description": "A message within a chat",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "readAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "A service order",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "budget": { "type": "number" },
        "negotiatedBudget": { "type": "number" },
        "commission": { "type": "number" },
        "address": { "type": "string" },
        "category": { "type": "string" },
        "customerId": { "type": "string" },
        "workerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_negotiation", "open", "in-progress", "completed"] },
        "time": { "type": "string" },
        "date": { "type": "string" },
        "workersCount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "customerId", "status"]
    },
    "VerificationCode": {
      "title": "VerificationCode",
      "description": "A verification code for a phone number",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A notification for a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["order", "payment", "system", "chat"] },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "isRead", "createdAt"]
    }
  },
  "firestore": {
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat sessions"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages in a chat session"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Service orders"
    },
    "/verification_codes/{phone}": {
      "schema": "VerificationCode",
      "description": "Store verification codes for phone numbers"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    }
  }
}
