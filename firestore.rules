rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: chats
    // Fields:
    //   - orderId: string (required)
    //   - customerId: string (required)
    //   - workerId: string (required)
    //   - lastMessage: string (optional)
    //   - lastMessageAt: timestamp (optional)
    //   - unreadCount: map (optional)
    //
    // Collection: chats/{chatId}/messages
    // Fields:
    //   - senderId: string (required)
    //   - text: string (required)
    //   - createdAt: timestamp (required)
    //   - readAt: timestamp (optional)
    //
    // Collection: users
    // Fields:
    //   - name: string (required)
    //   - phone: string (required)
    //   - role: string (required)
    //   - avatar: string (optional)
    //   - rating: number (optional)
    //   - reviews: number (optional)
    //   - balance: number (optional)
    //   - completedOrders: number (optional)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return isAuthenticated() && currentUserDoc().data != null
        ? currentUserDoc().data.role
        : null;
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.phone is string && data.phone.size() > 0 &&
             data.role in ['customer', 'worker', 'dispatcher'] &&
             data.createdAt is timestamp;
    }

    function isChatParticipant(chatData) {
      return isAuthenticated() && (request.auth.uid == chatData.customerId || request.auth.uid == chatData.workerId || request.auth.uid == chatData.dispatcherId);
    }

    function isValidChat(data) {
      return data.orderId is string &&
             (data.customerId == null || data.customerId is string) &&
             (data.workerId == null || data.workerId is string) &&
             (data.dispatcherId == null || data.dispatcherId is string);
    }

    function isValidMessage(data) {
      return data.senderId is string &&
             data.text is string &&
             data.text.size() > 0 &&
             data.text.size() < 5000 &&
             data.createdAt is timestamp;
    }

    function isValidOrder(data) {
      return data.title is string && data.title.size() >= 5 && data.title.size() < 200 &&
             data.customerId is string &&
             data.status in ['pending_negotiation', 'open', 'in-progress', 'completed'] &&
             (data.budget == null || data.budget is number) &&
             (data.address == null || data.address is string) &&
             (data.lat == null || data.lat is number) &&
             (data.lng == null || data.lng is number);
    }

    function isAdmin() {
      return currentUserRole() == 'dispatcher';
    }

    function isWorker() {
      return currentUserRole() == 'worker';
    }

    function canApplyToOrder() {
      return isWorker() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['candidates']) &&
        request.auth.uid in request.resource.data.candidates;
    }

    function canAssignedWorkerUpdateOrder() {
      return isWorker() &&
        resource.data.workerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory', 'assignedWorkers', 'workerLiveLocation', 'workerReviewed', 'review', 'reviews']);
    }

    function canWorkerReviewOrder() {
      return isWorker() &&
        resource.data.status == 'completed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerReviewed', 'review', 'reviews']) &&
        request.resource.data.workerReviewed == true &&
        request.resource.data.reviews is list;
    }

    function isReviewProfileUpdate() {
      return isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'rating', 'reviewsCount']) &&
        request.resource.data.rating is number &&
        request.resource.data.reviewsCount is number &&
        request.resource.data.reviews is list;
    }

    function isValidNotification(data) {
      return data.userId is string &&
             data.title is string &&
             data.message is string &&
             data.type in ['order', 'payment', 'system', 'chat'] &&
             data.isRead is bool &&
             data.createdAt is timestamp;
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && isChatParticipant(resource.data);
      allow create: if isAuthenticated() && isChatParticipant(request.resource.data) && isValidChat(request.resource.data);
      allow update: if isAuthenticated() && isChatParticipant(resource.data) && 
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'unreadCount']));

      match /messages/{messageId} {
        allow read: if isAuthenticated() && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if isAuthenticated() && 
                        isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data) &&
                        isValidMessage(request.resource.data) &&
                        request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && 
                        isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
                        resource.data.senderId != request.auth.uid; // Only recipient can mark as read
      }
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      
      allow update: if (isOwner(userId) && isValidUser(request.resource.data)) || isReviewProfileUpdate();
      
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidOrder(request.resource.data) && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (isOwner(resource.data.customerId) && isValidOrder(request.resource.data)) ||
        (isAdmin() && isValidOrder(request.resource.data)) ||
        canApplyToOrder() ||
        canWorkerReviewOrder() ||
        canAssignedWorkerUpdateOrder()
      );
      allow delete: if isOwner(resource.data.customerId) || isAdmin();
    }

    match /verification_codes/{phone} {
      allow read, create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidNotification(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
